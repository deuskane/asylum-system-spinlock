CAPI=2:

#-----------------------------------------------------------------------------
# Title      : spinlock Core file
# Project    : Asylum
#-----------------------------------------------------------------------------
# File       : spinlock.core
# Author     : mrosiere
#-----------------------------------------------------------------------------
# Description: 
#-----------------------------------------------------------------------------
# Copyright (c) 2025
#-----------------------------------------------------------------------------
# Revisions  :
# Date        Version  Author   Description
# 2026-05-25  1.0.0    mrosiere First Release
# 2026-06-06  1.0.1    mrosiere Add Name
# 2026-10-05  1.0.2    mrosiere Fix default target toplevel (sbi_spinlock), fix lock value
#                               description (0xFF when taken), add UVVM testbench
#-----------------------------------------------------------------------------

name        : asylum:system:spinlock:1.0.2
description : spinlock Module

#=========================================
generate:
#=========================================

  #---------------------------------------
  gen_csr:
  #---------------------------------------
    generator : regtool
    parameters:
      file         : hdl/csr/spinlock.hjson
      name         : spinlock
      copy         : hdl/csr
      logical_name : asylum

#=========================================
filesets:
#=========================================

  #---------------------------------------
  hdl:
  #---------------------------------------
    files        :
      - hdl/spinlock_pkg.vhd
      - hdl/sbi_spinlock.vhd
    file_type    : vhdlSource
    logical_name : asylum
    depend       :
      - asylum:utils:generators
      - asylum:utils:pkg
      - asylum:target:techmap

  #---------------------------------------
  sim:
  #---------------------------------------
    files:
      - sim/tb_spinlock.vhd
    file_type : vhdlSource-2008
    depend       :
      - bitvis:verification:uvvm

  #---------------------------------------
  # Lint Files (post_run hook of lint_ghdl_synth)
  #---------------------------------------
  files_lint:
    files:
      - syn/ghdl/sbi_spinlock_synth_top.vhd
      - syn/ghdl/ghdl_synth.sh : {file_type : user, copyto : ghdl_synth.sh}
    file_type : vhdlSource-2008

#=========================================
targets:
#=========================================

  #---------------------------------------
  default: &default
  #---------------------------------------
    description     : Default Target
    filesets        :
      - hdl
    toplevel        : sbi_spinlock
    default_tool    : ghdl
    generate        :
      - gen_csr

  #---------------------------------------
  # Lint : -Wall analysis and elaboration (empty simulation)
  #---------------------------------------
  lint_ghdl :
    << : *default
    description     : Lint with GHDL (-Wall analysis and elaboration of sbi_spinlock_synth_top)
    toplevel        : sbi_spinlock_synth_top
    filesets_append : [files_lint]
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options : ["-Wall"]

  #---------------------------------------
  # Synthesis check : lint_ghdl, then ghdl --synth -Wall of sbi_spinlock_synth_top
  # for each configuration of syn/ghdl/ghdl_synth.sh (post_run hook)
  #---------------------------------------
  lint_ghdl_synth :
    << : *default
    description     : Synthesis check, ghdl --synth -Wall of sbi_spinlock_synth_top (1 configuration)
    toplevel        : sbi_spinlock_synth_top
    filesets_append : [files_lint]
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options : ["-Wall"]
    hooks :
      post_run : [ghdl_synth]

  #---------------------------------------
  sim_spinlock:
  #---------------------------------------
    << : *default
    description     : Simulation of sbi_spinlock with VIP
    filesets_append :
      - sim
    toplevel        : tb_spinlock
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options : ["-Wall","-fsynopsys","-frelaxed","--no-vital-checks"]
        run_options     : ["--fst=dut.fst","--ieee-asserts=disable"]

#=========================================
scripts:
#=========================================

  #---------------------------------------
  # Hook of lint_ghdl_synth (cwd = work_root)
  #---------------------------------------
  ghdl_synth :
    cmd : [bash, ghdl_synth.sh]
