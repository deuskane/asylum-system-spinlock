CAPI=2:

#-----------------------------------------------------------------------------
# Title      : spinlock Core file
# Project    : Asylum
#-----------------------------------------------------------------------------
# File       : spinlock.core
# Author     : mrosiere
#-----------------------------------------------------------------------------
# Description: 
#-----------------------------------------------------------------------------
# Copyright (c) 2025
#-----------------------------------------------------------------------------
# Revisions  :
# Date        Version  Author   Description
# 2026-05-25  1.0.0    mrosiere First Release
# 2026-06-06  1.0.1    mrosiere Add Name
# 2026-10-05  1.0.2    mrosiere Fix default target toplevel (sbi_spinlock), fix lock value
#                               description (0xFF when taken), add UVVM testbench
#-----------------------------------------------------------------------------

name        : asylum:system:spinlock:1.0.2
description : spinlock Module

#=========================================
generate:
#=========================================

  #---------------------------------------
  gen_csr:
  #---------------------------------------
    generator : regtool
    parameters:
      file         : hdl/csr/spinlock.hjson
      name         : spinlock
      copy         : hdl/csr
      logical_name : asylum

#=========================================
filesets:
#=========================================

  #---------------------------------------
  hdl:
  #---------------------------------------
    files        :
      - hdl/spinlock_pkg.vhd
      - hdl/sbi_spinlock.vhd
    file_type    : vhdlSource
    logical_name : asylum
    depend       :
      - ">=asylum:utils:generators:2.8.0"
      - asylum:utils:pkg
      - asylum:target:techmap

  #---------------------------------------
  sim:
  #---------------------------------------
    files:
      - sim/tb_spinlock.vhd
    file_type : vhdlSource-2008
    depend       :
      - bitvis:verification:uvvm

  #---------------------------------------
  syn:
  #---------------------------------------
    files        :
      - syn/sbi_spinlock_wrapper.vhd
    file_type    : vhdlSource-2008
    logical_name : asylum

#=========================================
targets:
#=========================================

  #---------------------------------------
  default: &default
  #---------------------------------------
    description     : Default Target
    filesets        :
      - hdl
    toplevel        : sbi_spinlock
    default_tool    : ghdl
    generate        :
      - gen_csr

  #---------------------------------------
  # Lint : -Wall analysis and elaboration (empty simulation)
  #---------------------------------------
  lint_ghdl : &lint_ghdl
    << : *default
    description     : Lint with GHDL (-Wall analysis and elaboration of sbi_spinlock_wrapper)
    toplevel        : asylum.sbi_spinlock_wrapper
    filesets_append : [syn]
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options : ["-Wall"]

  #---------------------------------------
  # Synthesis check : -Wall analysis, ghdl --synth -Wall and elaboration
  # (no simulation) of sbi_spinlock_wrapper with the generics of the target.
  # The pre_run hook (ghdl_synth.sh of asylum:utils:generators) adds
  # ghdl_synth.mk to the edalize Makefile.
  # FuseSoC merges tools in depth : analyze_options comes from lint_ghdl.
  #---------------------------------------
  lint_ghdl_synth_default : &lint_ghdl_synth
    << : *lint_ghdl
    description     : Synthesis check of sbi_spinlock_wrapper, default generics
    tools :
      ghdl :
        run_options     : ["--no-run"]
    hooks :
      pre_run : [ghdl_synth]

  #---------------------------------------
  sim_spinlock:
  #---------------------------------------
    << : *default
    description     : Simulation of sbi_spinlock with VIP
    filesets_append :
      - sim
    toplevel        : tb_spinlock
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options : ["-Wall","-fsynopsys","-frelaxed","--no-vital-checks"]
        run_options     : ["--fst=dut.fst","--ieee-asserts=disable"]

#=========================================
scripts:
#=========================================

  #---------------------------------------
  # pre_run hook of lint_ghdl_synth_* (cwd = work_root)
  #---------------------------------------
  ghdl_synth :
    cmd : [bash, ghdl_synth.sh]
